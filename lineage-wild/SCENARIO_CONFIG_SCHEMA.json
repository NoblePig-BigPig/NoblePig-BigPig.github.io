{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/lineage-game-scenario-config-v1.schema.json",
  "title": "Lineage Wild Scenario Config",
  "type": "object",
  "required": ["schemaVersion", "configType", "gameId", "scenarioId", "name", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "configType": { "const": "LINEAGE_GAME_SCENARIO_CONFIG" },
    "gameId": { "const": "lineage-wild-collection" },
    "scenarioId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "mathCompatibility": {
      "type": "object",
      "properties": {
        "configId": { "type": ["string", "null"] },
        "modelId": { "type": ["string", "null"] },
        "strict": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "resetGameStateOnStart": { "type": "boolean" },
        "stopWhenComplete": { "type": "boolean" },
        "repeat": { "type": "boolean" },
        "accounting": { "const": "scenario" }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "range": {
      "oneOf": [
        { "type": "number" },
        { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        { "type": "object", "properties": { "min": { "type": "number" }, "max": { "type": "number" } }, "additionalProperties": false }
      ]
    },
    "cell": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" },
        {
          "type": "object",
          "required": ["symbol"],
          "properties": {
            "symbol": { "type": "string" },
            "label": { "type": "string" },
            "color": { "enum": ["blue", "red", "gold", "green"] },
            "multiplier": { "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "const": "math" }] }
          },
          "additionalProperties": false
        }
      ]
    },
    "when": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["any", "base", "normal", "super"] },
        "globalSpinNumber": { "type": ["integer", "null"], "minimum": 1 },
        "paidSpinIndex": { "type": ["integer", "null"], "minimum": 1 },
        "freeSpinIndex": { "type": ["integer", "null"], "minimum": 1 },
        "bonusPurchaseType": { "enum": ["normal", "super", null] },
        "stickyCount": { "type": ["integer", "null"], "minimum": 0 },
        "stickyReelsContains": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "targetWinX": { "$ref": "#/$defs/range" },
        "scatterCount": { "$ref": "#/$defs/range" },
        "newStickyCount": { "$ref": "#/$defs/range" },
        "stickyAfterCount": { "$ref": "#/$defs/range" },
        "expansionColors": { "type": "array", "items": { "enum": ["blue", "red", "gold", "green"] }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "assertions": {
      "type": "object",
      "properties": {
        "winX": { "$ref": "#/$defs/range" },
        "scatterCount": { "$ref": "#/$defs/range" },
        "newStickyCount": { "$ref": "#/$defs/range" },
        "stickyAfterCount": { "$ref": "#/$defs/range" },
        "stickyReelsAfter": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "bonusTriggered": { "enum": ["normal", "super", null] },
        "retriggerSpins": { "type": "integer", "minimum": 0 },
        "maxWinReached": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "enum": ["rng", "fixed", "constraints"] },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "reels": {
          "type": ["array", "null"],
          "minItems": 6,
          "maxItems": 6,
          "items": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/cell" } }
        },
        "constraints": { "$ref": "#/$defs/constraints" }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["id", "board"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "when": { "$ref": "#/$defs/when" },
        "board": { "$ref": "#/$defs/board" },
        "assertions": { "$ref": "#/$defs/assertions" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
